prefix_rule(
    pattern = ["npm.cmd", "install"],
    decision = "allow",
    justification = "Instala únicamente las dependencias declaradas por LenguArcade.",
    match = [
        "npm.cmd install",
    ],
)

prefix_rule(
    pattern = ["npm.cmd", "run", ["check", "apps:status", "apps:publish"]],
    decision = "allow",
    justification = "Permite validar LenguArcade y publicar exclusivamente el núcleo mediante el script protegido.",
    match = [
        "npm.cmd run check",
        "npm.cmd run apps:status",
        "npm.cmd run apps:publish -- \"Actualiza el núcleo de LenguArcade\"",
    ],
    not_match = [
        "npm.cmd run apps:pull",
        "clasp push --force",
    ],
)
