/**
 * LenguArcade · Rayuela
 * Adaptador reversible para instalaciones de Sheets anteriores al alta de Rayuela
 * y para la interfaz de evaluación específica del profesor.
 */
var LA_RAYUELA_GAME_ = {
  gameId:'rayuela',
  nombre:'Rayuela',
  subtitulo:'Tu historia. Tus decisiones.',
  categoria:'Escritura',
  competencias:'narracion,creatividad,redaccion,coherencia,planificacion',
  estado:'beta',
  orden:8,
  color:'#22d3ee',
  icono:'⌗',
  url:'https://rawcdn.githack.com/pablogarciablancov/lenguarcade/4e661e74e14ed60adee338c1f4123ac409436f65/games/rayuela/index.html',
  descripcion:'Crea una aventura interactiva con decisiones, caminos alternativos y múltiples finales.',
  banner:'rayuela',
  activo:true
};

// seedGames_ no modifica hojas que ya tienen datos. Este fallback hace visible Rayuela
// también en instalaciones existentes, sin resembrar ni borrar configuraciones del profesor.
var LA_RAYUELA_BASE_GET_ACTIVE_GAMES_ = getActiveGames_;
getActiveGames_ = function() {
  var games = LA_RAYUELA_BASE_GET_ACTIVE_GAMES_().slice();
  if (!games.some(function(game) { return String(game.gameId || '').toLowerCase() === 'rayuela'; })) {
    games.push(Object.assign({}, LA_RAYUELA_GAME_));
  }
  return games.sort(function(a,b) { return Number(a.orden || 0) - Number(b.orden || 0); });
};

var LA_RAYUELA_BASE_FIND_GAME_ = findGame_;
findGame_ = function(gameId) {
  var found = LA_RAYUELA_BASE_FIND_GAME_(gameId);
  if (found) return found;
  return String(gameId || '').toLowerCase() === 'rayuela' ? Object.assign({}, LA_RAYUELA_GAME_) : null;
};

function getRayuelaTeacherPatch_() {
  return "\n<style>\n.rayuelaTeacherBox{margin-top:14px;padding:16px;border:1px solid rgba(34,211,238,.28);border-radius:18px;background:linear-gradient(135deg,rgba(34,211,238,.07),rgba(139,92,246,.07))}\n.rayuelaTeacherHead{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap}\n.rayuelaTeacherGrid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px;margin-top:12px}\n.rayuelaTeacherMetric{padding:9px;border:1px solid var(--line);border-radius:12px;background:rgba(0,0,0,.13)}\n.rayuelaTeacherMetric span{display:block;color:var(--muted);font-size:10px}.rayuelaTeacherMetric b{font-size:17px}\n.rayuelaRubric{margin-top:14px;padding-top:14px;border-top:1px solid var(--line)}\n.rayuelaRubricRow{display:grid;grid-template-columns:minmax(180px,1.2fr) 80px 90px minmax(180px,1fr);gap:8px;margin:8px 0;align-items:start}\n.rayuelaRubricRow input,.rayuelaRubricRow textarea,.rayuelaNodeComment select,.rayuelaNodeComment textarea,.rayuelaOverall{width:100%;border:1px solid var(--line);border-radius:10px;background:rgba(0,0,0,.16);color:inherit;padding:8px}\n.rayuelaRubricRow textarea{min-height:52px;resize:vertical}.rayuelaNodeComment{display:grid;grid-template-columns:minmax(170px,.7fr) minmax(220px,1.3fr) auto;gap:8px;margin:8px 0;align-items:start}.rayuelaNodeComment textarea{min-height:62px;resize:vertical}\n.rayuelaRubricLabels{display:grid;grid-template-columns:minmax(180px,1.2fr) 80px 90px minmax(180px,1fr);gap:8px;color:var(--muted);font-size:10px;margin-top:8px}\n.rayuelaRubricScore{font-size:22px;font-weight:900}.rayuelaTeacherActions{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-top:10px}\n.rayuelaTeacherStatus{color:var(--muted);font-size:11px}\n@media(max-width:900px){.rayuelaTeacherGrid{grid-template-columns:repeat(2,1fr)}.rayuelaRubricRow,.rayuelaRubricLabels{grid-template-columns:1fr 65px 75px}.rayuelaRubricRow textarea,.rayuelaRubricLabels span:last-child{grid-column:1/-1}.rayuelaNodeComment{grid-template-columns:1fr}.rayuelaNodeComment button{justify-self:start}}\n</style>\n<script>\n(function(){\n  if(window.__LA_RAYUELA_TEACHER_PATCH__)return;\n  window.__LA_RAYUELA_TEACHER_PATCH__=true;\n  var DEFAULT_CRITERIA=[\n    {id:'estructura',label:'Estructura narrativa',weight:20,score:0,comment:''},\n    {id:'ramificacion',label:'Ramificación y consecuencias',weight:20,score:0,comment:''},\n    {id:'escritura',label:'Calidad de escritura',weight:20,score:0,comment:''},\n    {id:'correccion',label:'Corrección lingüística',weight:20,score:0,comment:''},\n    {id:'creatividad',label:'Creatividad y elaboración',weight:20,score:0,comment:''}\n  ];\n  var currentDetail=null;\n  function escR(value){return String(value==null?'':value).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];});}\n  function readRaw(row){try{return typeof row.rawJson==='string'?JSON.parse(row.rawJson||'{}'):(row.rawJson||{});}catch(e){return {};}}\n  function getProject(row){\n    var raw=readRaw(row||{});\n    var save=raw.save||(raw.rawGameData&&raw.rawGameData.save)||{};\n    return save&&typeof save==='object'?save:{};\n  }\n  function projectMetrics(project,row){\n    var nodes=Array.isArray(project.nodes)?project.nodes:[];\n    var words=0,choices=0,endings=0;\n    nodes.forEach(function(node){\n      var match=String(node.text||'').trim().match(/\\S+/g);words+=match?match.length:0;\n      choices+=Array.isArray(node.choices)?node.choices.filter(function(choice){return !!choice.targetId;}).length:0;\n      if(node.type==='ending'||node.type==='secret')endings++;\n    });\n    var raw=readRaw(row||{}),metrics=raw.metrics||(raw.rawGameData&&raw.rawGameData.metrics)||{};\n    return {\n      nodes:Number(metrics.nodes||nodes.length||0),\n      words:Number(metrics.words||words||0),\n      choices:Number(metrics.choices||choices||0),\n      endings:Number(metrics.endings||endings||0),\n      complexity:Number(metrics.complexity||metrics.stars||Math.max(0,Math.min(5,Math.ceil(nodes.length/8)))||0),\n      structuralErrors:Number(metrics.structuralErrors||row.errors||0),\n      status:String(project.status||'draft'),\n      submissions:Array.isArray(project.submissions)?project.submissions.length:0\n    };\n  }\n  function getEvaluation(detail){\n    return (detail.evaluations||[]).find(function(item){return item.scope==='game'&&item.gameId==='rayuela';})||null;\n  }\n  function criteriaFor(detail){\n    var ev=getEvaluation(detail),existing=ev&&ev.breakdown&&Array.isArray(ev.breakdown.criteria)?ev.breakdown.criteria:null;\n    return (existing&&existing.length?existing:DEFAULT_CRITERIA).map(function(item,index){\n      return {id:String(item.id||('criterion_'+(index+1))),label:String(item.label||''),weight:Number(item.weight||0),score:Number(item.score||0),comment:String(item.comment||'')};\n    });\n  }\n  function nodeOptions(project,selected){\n    var nodes=Array.isArray(project.nodes)?project.nodes:[];\n    return nodes.map(function(node){return '<option value=\"'+escR(node.id)+'\" '+(String(node.id)===String(selected)?'selected':'')+'>'+escR((node.title||'Escena')+' · '+(node.type||'story'))+'</option>';}).join('');\n  }\n  function renderRayuelaTeacher(detail){\n    currentDetail=detail;\n    var root=document.getElementById('studentDetailProgress');if(!root)return;\n    var old=document.getElementById('rayuelaTeacherBox');if(old)old.remove();\n    var row=(detail.progress||[]).find(function(item){return String(item.gameId)==='rayuela';});if(!row)return;\n    var rootProject=getProject(row),submissions=Array.isArray(rootProject.submissions)?rootProject.submissions:[];\n    var latestSubmission=submissions.length?submissions[submissions.length-1]:null;\n    var project=latestSubmission&&latestSubmission.project&&typeof latestSubmission.project==='object'?latestSubmission.project:rootProject;\n    var nodes=Array.isArray(project.nodes)?project.nodes:[];\n    if(!nodes.length&&!Number(row.sessions||0))return;\n    var m=projectMetrics(project,row);m.submissions=submissions.length;if(latestSubmission){m.status='submitted';var ss=latestSubmission.stats||{};m.nodes=Number(ss.nodes||m.nodes);m.words=Number(ss.words||m.words);m.choices=Number(ss.connectedChoices||ss.choices||m.choices);m.endings=Number(ss.endings||m.endings);m.complexity=Number(ss.stars||m.complexity);}\n    var ev=getEvaluation(detail),criteria=criteriaFor(detail);\n    var breakdown=ev&&ev.breakdown||{},comments=Array.isArray(breakdown.nodeComments)?breakdown.nodeComments:[];\n    var box=document.createElement('section');box.id='rayuelaTeacherBox';box.className='rayuelaTeacherBox';\n    var metrics=[\n      ['Escenas',m.nodes],['Palabras',m.words],['Decisiones',m.choices],['Finales',m.endings],['Complejidad',m.complexity+'/5'],\n      ['Errores estruct.',m.structuralErrors],['Estado',m.status],['Entregas',m.submissions],['XP',row.xp||rootProject.xp||project.xp||0],['Última actividad',row.lastActivity?formatDate(row.lastActivity):'—']\n    ];\n    var criterionRows=criteria.map(function(item){\n      return '<div class=\"rayuelaRubricRow\" data-r-criterion=\"'+escR(item.id)+'\"><input data-r-label value=\"'+escR(item.label)+'\"><input data-r-weight type=\"number\" min=\"0\" max=\"100\" step=\"1\" value=\"'+escR(item.weight)+'\"><input data-r-score type=\"number\" min=\"0\" max=\"10\" step=\"0.25\" value=\"'+escR(item.score)+'\"><textarea data-r-comment placeholder=\"Observación sobre este criterio\">'+escR(item.comment)+'</textarea></div>';\n    }).join('');\n    var commentRows=comments.map(function(item,index){\n      return '<div class=\"rayuelaNodeComment\" data-r-node-comment=\"'+index+'\"><select data-r-node>'+nodeOptions(project,item.nodeId)+'</select><textarea data-r-node-text placeholder=\"Comentario para esta escena\">'+escR(item.comment||'')+'</textarea><button type=\"button\" class=\"ghost\" data-r-remove-comment>Quitar</button></div>';\n    }).join('');\n    box.innerHTML='<div class=\"rayuelaTeacherHead\"><div><strong>🧭 Rayuela · proyecto narrativo</strong><div class=\"sub\">Mapa, proceso y rúbrica de esta aventura. La nota la decides tú.</div></div><div><span class=\"sub\">Nota Rayuela</span><div class=\"rayuelaRubricScore\" id=\"rayuelaRubricScore\">'+(ev?Number(ev.score||0).toFixed(2):'—')+'</div></div></div>'+\n      '<div class=\"rayuelaTeacherGrid\">'+metrics.map(function(x){return '<div class=\"rayuelaTeacherMetric\"><span>'+escR(x[0])+'</span><b>'+escR(x[1])+'</b></div>';}).join('')+'</div>'+\n      '<div class=\"rayuelaRubric\"><h3>Rúbrica de evaluación</h3><div class=\"sub\">Puedes cambiar criterios, pesos, puntuaciones y comentarios.</div><div class=\"rayuelaRubricLabels\"><span>Criterio</span><span>Peso %</span><span>Nota /10</span><span>Comentario</span></div><div id=\"rayuelaCriteria\">'+criterionRows+'</div>'+\n      '<label class=\"sub\" for=\"rayuelaOverall\">Comentario general</label><textarea id=\"rayuelaOverall\" class=\"rayuelaOverall\" rows=\"3\" placeholder=\"Comentario general para el alumno\">'+escR(breakdown.overallComment||'')+'</textarea>'+\n      '<h3 style=\"margin-top:14px\">Comentarios por escena</h3><div class=\"sub\">El alumno los verá al seleccionar la escena correspondiente y podrá marcarlos como revisados.</div><div id=\"rayuelaNodeComments\">'+commentRows+'</div>'+\n      '<div class=\"rayuelaTeacherActions\"><button type=\"button\" class=\"ghost\" id=\"rayuelaAddComment\">＋ Comentario de escena</button><button type=\"button\" id=\"rayuelaSaveEvaluation\">Guardar evaluación</button><span class=\"rayuelaTeacherStatus\" id=\"rayuelaTeacherStatus\">'+(ev&&ev.updatedAt?'Última evaluación: '+escR(formatDate(ev.updatedAt)):'Sin evaluar todavía')+'</span></div></div>';\n    root.parentNode.insertBefore(box,root.nextSibling);\n    bindRayuelaTeacher(project);\n    recalcRayuelaScore();\n  }\n  function recalcRayuelaScore(){\n    var rows=[].slice.call(document.querySelectorAll('#rayuelaCriteria .rayuelaRubricRow')),sum=0,total=0;\n    rows.forEach(function(row){var w=Math.max(0,Number(row.querySelector('[data-r-weight]').value||0)),s=Math.max(0,Math.min(10,Number(row.querySelector('[data-r-score]').value||0)));sum+=w*s;total+=w;});\n    var out=document.getElementById('rayuelaRubricScore');if(out)out.textContent=total?(sum/total).toFixed(2):'—';\n  }\n  function bindRayuelaTeacher(project){\n    document.querySelectorAll('#rayuelaCriteria input').forEach(function(input){input.addEventListener('input',recalcRayuelaScore);});\n    document.querySelectorAll('[data-r-remove-comment]').forEach(function(btn){btn.onclick=function(){btn.closest('.rayuelaNodeComment').remove();};});\n    var add=document.getElementById('rayuelaAddComment');if(add)add.onclick=function(){\n      var nodes=Array.isArray(project.nodes)?project.nodes:[];if(!nodes.length)return;\n      var wrap=document.createElement('div');wrap.className='rayuelaNodeComment';\n      wrap.innerHTML='<select data-r-node>'+nodeOptions(project,nodes[0].id)+'</select><textarea data-r-node-text placeholder=\"Comentario para esta escena\"></textarea><button type=\"button\" class=\"ghost\" data-r-remove-comment>Quitar</button>';\n      document.getElementById('rayuelaNodeComments').appendChild(wrap);wrap.querySelector('[data-r-remove-comment]').onclick=function(){wrap.remove();};\n    };\n    var save=document.getElementById('rayuelaSaveEvaluation');if(save)save.onclick=saveRayuelaEvaluation;\n  }\n  async function saveRayuelaEvaluation(){\n    if(!currentDetail)return;\n    var button=document.getElementById('rayuelaSaveEvaluation'),status=document.getElementById('rayuelaTeacherStatus');button.disabled=true;status.textContent='Guardando evaluación...';\n    try{\n      var criteria=[].slice.call(document.querySelectorAll('#rayuelaCriteria .rayuelaRubricRow')).map(function(row,index){\n        return {id:row.dataset.rCriterion||('criterion_'+(index+1)),label:row.querySelector('[data-r-label]').value,weight:Number(row.querySelector('[data-r-weight]').value||0),score:Number(row.querySelector('[data-r-score]').value||0),comment:row.querySelector('[data-r-comment]').value};\n      });\n      var nodeComments=[].slice.call(document.querySelectorAll('#rayuelaNodeComments .rayuelaNodeComment')).map(function(row,index){\n        return {id:'node_comment_'+Date.now()+'_'+index,nodeId:row.querySelector('[data-r-node]').value,comment:row.querySelector('[data-r-node-text]').value};\n      }).filter(function(item){return item.nodeId&&item.comment.trim();});\n      var rayRow=(currentDetail.progress||[]).find(function(item){return String(item.gameId)==='rayuela';})||{},project=getProject(rayRow),submissions=Array.isArray(project.submissions)?project.submissions:[];\n      var latest=submissions.length?submissions[submissions.length-1]:null;\n      var response=await edge('teacher-rayuela-evaluation',{studentId:currentDetail.student.studentId,criteria:criteria,overallComment:document.getElementById('rayuelaOverall').value,nodeComments:nodeComments,projectId:project.id||'',submissionId:latest&&latest.id||''});\n      currentDetail.evaluations=(currentDetail.evaluations||[]).filter(function(item){return !(item.scope==='game'&&item.gameId==='rayuela');});\n      currentDetail.evaluations.push({scope:'game',gameId:'rayuela',score:response.score,breakdown:response.breakdown||{},updatedAt:response.updatedAt});\n      status.textContent='Evaluación guardada · '+Number(response.score||0).toFixed(2)+'/10';\n      renderRayuelaTeacher(currentDetail);\n    }catch(error){status.textContent='No se pudo guardar: '+(error.message||String(error));}\n    finally{if(button)button.disabled=false;}\n  }\n  function install(){\n    if(typeof renderStudentDetail!=='function'){setTimeout(install,100);return;}\n    var base=renderStudentDetail;\n    renderStudentDetail=function(detail){var value=base(detail);setTimeout(function(){renderRayuelaTeacher(detail||{});},0);return value;};\n  }\n  install();\n})();\n</script>";
}

// Se inyecta únicamente en profesor; el alumno ya tiene integración Rayuela nativa
// en LenguArcade_Alumno.html.
var LA_RAYUELA_BASE_BUILD_HTML_OUTPUT_ = buildLenguArcadeHtmlOutput_;
buildLenguArcadeHtmlOutput_ = function(file, title, patchAlumnoGoogle) {
  var output = LA_RAYUELA_BASE_BUILD_HTML_OUTPUT_(file, title, patchAlumnoGoogle);
  if (file !== 'LenguArcade_Profesor') return output;
  var content = output.getContent();
  var patch = getRayuelaTeacherPatch_();
  var html = content.indexOf('</body>') !== -1 ? content.replace('</body>', patch + '\n</body>') : content + patch;
  return HtmlService.createHtmlOutput(html).setTitle(title).setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
};
